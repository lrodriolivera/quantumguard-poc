# QuantumGuard AI - Environment Variables
# Copy this file to .env and fill in the values

# ======================
# Database Configuration
# ======================
POSTGRES_DB=quantumguard
POSTGRES_USER=quantum_user
POSTGRES_PASSWORD=your_secure_password_here

# ======================
# Redis Configuration
# ======================
REDIS_PASSWORD=your_redis_password_here

# ======================
# JWT Configuration
# ======================
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# Application URLs
# ======================
ALLOWED_ORIGINS=https://quantumguard.ai,https://www.quantumguard.ai
VITE_API_URL=https://api.quantumguard.ai

# ======================
# Optional: SSL/TLS
# ======================
# SSL_CERT_PATH=/etc/ssl/certs/quantumguard.crt
# SSL_KEY_PATH=/etc/ssl/private/quantumguard.key

# ======================
# Optional: Monitoring
# ======================
# SENTRY_DSN=your_sentry_dsn_here
# LOG_LEVEL=info
