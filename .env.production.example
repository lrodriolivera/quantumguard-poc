# QuantumGuard AI - Production Environment Variables
# Copy to .env and fill in real values before deploying
# Usage: docker compose -f docker-compose.prod.yml --env-file .env up -d

# ======================
# Database (REQUIRED)
# ======================
POSTGRES_DB=quantumguard
POSTGRES_USER=quantum_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_min_20_chars

# ======================
# Redis (REQUIRED)
# ======================
REDIS_PASSWORD=CHANGE_ME_redis_password_min_20_chars

# ======================
# Authentication (REQUIRED)
# ======================
JWT_SECRET=CHANGE_ME_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ======================
# PKI / crypto-service (REQUIRED)
# ======================
# Unlocks the encrypted CA private keys. Store an offline copy separate from PKI backups.
PKI_KEY_PASSPHRASE=CHANGE_ME_long_random_passphrase
# Shared secret the backend presents to the crypto-service
CRYPTO_SERVICE_TOKEN=CHANGE_ME_random_token_at_least_32_chars
# Set to false after the first `python pki_admin.py init`
PKI_AUTO_INIT_CA=true
PKI_PUBLIC_BASE_URL=https://quantumguard.ai

# ======================
# Firma simple: external signers, OTP email, plans (REQUIRED for P0)
# ======================
# Resend API key (resend.com) — sends signer invites and OTP codes. Without
# it, creating an envelope fails with 503 instead of silently not sending.
RESEND_API_KEY=CHANGE_ME_resend_api_key
RESEND_FROM_EMAIL=QuantumGuard <firmas@postcuantica.io>
# Base URL the signing links point to (the frontend, not the API)
FRONTEND_BASE_URL=https://app.postcuantica.io

# ======================
# Billing (Stripe) — wired up once checkout/webhooks are built
# ======================
# STRIPE_SECRET_KEY=CHANGE_ME_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=CHANGE_ME_stripe_webhook_signing_secret
# STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_PRO=price_...

# ======================
# CORS & URLs (REQUIRED)
# ======================
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://quantumguard.ai,https://www.quantumguard.ai
# Public URL for the frontend to reach the API (used at build time)
VITE_API_URL=https://quantumguard.ai/api

# ======================
# Application
# ======================
NODE_ENV=production
LOG_LEVEL=info

# ======================
# SSL/TLS (Optional - for HTTPS)
# ======================
# SSL_CERT_PATH=/etc/ssl/certs/quantumguard.crt
# SSL_KEY_PATH=/etc/ssl/private/quantumguard.key

# ======================
# Monitoring (Optional)
# ======================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
